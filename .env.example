# Application
APP_NAME=pa-explorer
APP_VERSION=0.1.0
DEBUG=true

# Database (SQLite for local dev — switch to postgresql://user:pass@host/db for prod)
DATABASE_URL=sqlite:///./pa_explorer.db

# IBM Planning Analytics SaaS
IBM_PA_BASE_URL=https://eu-central-1.planninganalytics.saas.ibm.com
IBM_PA_TENANT_ID=your-tenant-id-here
IBM_PA_API_KEY=your-api-key-here
IBM_PA_SERVERS_TTL_SECONDS=300
IBM_PA_CUBES_TTL_SECONDS=300
IBM_PA_DIMENSIONS_TTL_SECONDS=300
