# Application
APP_NAME=pa-explorer
APP_VERSION=0.1.0
DEBUG=true

# Database (SQLite for local dev — switch to postgresql://user:pass@host/db for prod)
DATABASE_URL=sqlite:///./pa_explorer.db

# IBM Planning Analytics SaaS
IBM_PA_BASE_URL=https://eu-central-1.planninganalytics.saas.ibm.com
IBM_PA_TENANT_ID=your-tenant-id-here
IBM_PA_API_KEY=your-api-key-here
IBM_PA_SERVERS_TTL_SECONDS=300
IBM_PA_CUBES_TTL_SECONDS=300
IBM_PA_DIMENSIONS_TTL_SECONDS=300

# Auth
PA_EXPLORER_ENCRYPTION_KEY=<générer via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"> # The encryption key for securing auth tokens (keep this secret!) (already registered in Bitwarden)
PA_EXPLORER_INITIAL_ADMIN_EMAIL=admin@example.com (the email of the initial admin user to create on first run)
AUTH_SESSION_TTL_HOURS=24
AUTH_MAGIC_LINK_TTL_MINUTES=15
